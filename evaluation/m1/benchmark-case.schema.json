{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.gkr/evaluation/m1/benchmark-case.schema.json",
  "title": "GKR M1 benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "query_class",
    "question",
    "scope",
    "expectations",
    "metric_targets"
  ],
  "properties": {
    "schema_version": {
      "const": "gkr-m1-case-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "query_class": {
      "enum": [
        "exact_factual",
        "numeric_conditional",
        "semantic_paraphrase",
        "temporal",
        "authorization",
        "unknown_oos",
        "conflict",
        "multi_document",
        "adversarial",
        "citation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "groups", "as_of"],
      "properties": {
        "actor": {
          "type": ["string", "null"]
        },
        "groups": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "known_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant_references",
        "forbidden_references",
        "publication",
        "support_label"
      ],
      "properties": {
        "relevant_references": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "forbidden_references": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "publication": {
          "enum": ["published", "refused", "withheld", "not_asserted"]
        },
        "support_label": {
          "enum": ["supported", "unsupported", "conflicting", "not_asserted"]
        },
        "strict_answer": {
          "type": ["string", "null"]
        },
        "required_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_citations": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "metric_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "recall_at_k",
          "mrr",
          "ndcg",
          "stale_version_exposure",
          "unauthorized_exposure",
          "oos_false_load",
          "oos_false_refusal",
          "strict_answer_accuracy",
          "citation_precision",
          "citation_coverage",
          "claim_support",
          "latency_ms",
          "peak_process_rss_bytes",
          "prompt_tokens"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "oracle_notes": {
      "type": "string"
    }
  }
}
